    "eslint-plugin-svelte": "^2.46.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.1",
    "prettier-plugin-svelte": "^3.3.2",
    "svelte": "^5.2.0",
    "svelte-check": "^4.1.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.16.0",
    "vite": "^6.0.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@monaco-editor/loader": "^1.4.0",
